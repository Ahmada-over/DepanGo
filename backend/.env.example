# TechConnect — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# NE JAMAIS commiter le fichier .env dans git.

# ---- Environnement ----
ENVIRONMENT=development   # development | production

# ---- Base de données PostgreSQL ----
# Option 1 : URL complète (recommandée)
DATABASE_URL=postgresql+asyncpg://mirahtec:VOTRE_MOT_DE_PASSE@localhost:5432/techconnect

# Option 2 : composants séparés (utilisé si DATABASE_URL est absent)
POSTGRES_USER=mirahtec
POSTGRES_PASSWORD=VOTRE_MOT_DE_PASSE
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=techconnect

# ---- JWT Security ----
# Générez une clé forte : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REMPLACEZ_PAR_UNE_CLE_ALEATOIRE_FORTE

# ---- CORS ----
# Liste des origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ---- Matching Engine ----
MAX_RADIUS_KM=25.0
INITIAL_RADIUS_KM=10.0
MATCHING_TIMEOUT_SECONDS=90
